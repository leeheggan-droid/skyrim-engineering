{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyrim-engineering.example/schemas/anniversary-together-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "privateClientSlots", "results"],
  "properties": {
    "schema": {"const": "skyrim-engineering.anniversary-together.manifest/v1"},
    "privateClientSlots": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["slot-1", "slot-2", "slot-3"]}},
    "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["testId", "path"], "properties": {"testId": {"type": "string", "pattern": "^(CONTROL|SYNC|AE)-[0-9]{3}$"}, "path": {"type": "string", "pattern": "^results/[A-Z]+-[0-9]{3}\\.json$"}}}}
  }
}
