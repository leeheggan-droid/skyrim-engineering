+TEST_CASE("Inventory route production messages survive both factories", "[encoding.factory][inventory.route]")
+{
+    RequestInventoryChanges request;
+    request.ServerId = 42;
+    request.Item.BaseId.ModId = 7;
+    request.Item.BaseId.BaseId = 0xABC;
+    request.Item.Count = 1;
+    request.Drop = false;
+    request.UpdateClients = false;
+
+    Buffer clientBuffer(1000);
+    Buffer::Writer clientWriter(&clientBuffer);
+    request.Serialize(clientWriter);
+    Buffer::Reader clientReader(&clientBuffer);
+    ClientMessageFactory clientFactory;
+    auto clientMessage = clientFactory.Extract(clientReader);
+    REQUIRE(clientMessage);
+    REQUIRE(clientMessage->GetOpcode() == kRequestInventoryChanges);
+    auto decodedRequest = CastUnique<RequestInventoryChanges>(std::move(clientMessage));
+    REQUIRE(*decodedRequest == request);
+    REQUIRE_FALSE(decodedRequest->UpdateClients);
+
+    NotifyInventoryChanges notify;
+    notify.ServerId = decodedRequest->ServerId;
+    notify.Item = decodedRequest->Item;
+    notify.Drop = decodedRequest->Drop;
+
+    Buffer serverBuffer(1000);
+    Buffer::Writer serverWriter(&serverBuffer);
+    notify.Serialize(serverWriter);
+    Buffer::Reader serverReader(&serverBuffer);
+    ServerMessageFactory serverFactory;
+    auto serverMessage = serverFactory.Extract(serverReader);
+    REQUIRE(serverMessage);
+    REQUIRE(serverMessage->GetOpcode() == kNotifyInventoryChanges);
+    auto decodedNotify = CastUnique<NotifyInventoryChanges>(std::move(serverMessage));
+    REQUIRE(*decodedNotify == notify);
+    REQUIRE(decodedNotify->ServerId == request.ServerId);
+    REQUIRE(decodedNotify->Item == request.Item);
+}
