diff --git a/Code/tests/src/reverse.cpp b/Code/tests/src/reverse.cpp
index a71ef26..edcb28f 100644
--- a/Code/tests/src/reverse.cpp
+++ b/Code/tests/src/reverse.cpp
@@ -20,11 +20,17 @@ TEST_CASE("Load the reverse dll", "[reverse.app]")
     {
 #if TP_RELEASE
         const auto handle = LoadLibraryA("DLL_r.dll");
 #else
         const auto handle = LoadLibraryA("DLL.dll");
 #endif

+        INFO("LoadLibraryA(DLL) error=" << GetLastError());
+        REQUIRE(handle != nullptr);
+
         const auto pSetParams = GetProcAddress(handle, "SetParams");
+
+        INFO("GetProcAddress(SetParams) error=" << GetLastError());
+        REQUIRE(pSetParams != nullptr);

         using TSetParams = void(*)(void*);
         const auto callableSetParams = reinterpret_cast<TSetParams>(pSetParams);
@@ -36,7 +42,9 @@ TEST_CASE("Load the reverse dll", "[reverse.app]")
         using TGetWinmain = void* (__stdcall*)();
         TGetWinmain OriginalGetWinmain = nullptr;

         OriginalGetWinmain = (TGetWinmain)GetProcAddress(LoadLibraryA("api-ms-win-crt-runtime-l1-1-0.dll"), "_get_narrow_winmain_command_line");

+        INFO("GetProcAddress(_get_narrow_winmain_command_line) error=" << GetLastError());
+        REQUIRE(OriginalGetWinmain != nullptr);
         CHECK(OriginalGetWinmain() != nullptr);
 #endif

diff --git a/xmake.lua b/xmake.lua
index 5d8b6ff..d94cdc8 100644
--- a/xmake.lua
+++ b/xmake.lua
@@ -41,9 +41,21 @@ target("TiltedReverse")
     add_defines("NOMINMAX") -- stupid ass windows
     add_packages("tiltedcore", "mimalloc", "hopscotch-map", "minhook", "mem", "xbyak")

+-- The reverse test loads this fixture DLL at runtime.  The legacy premake
+-- project built it, but the xmake migration omitted the target.
+target("DLL")
+    set_kind("shared")
+    set_group("Tests")
+    if is_mode("release", "releasedbg") then
+        set_basename("DLL_r")
+    end
+    add_files("Code/dll/src/*.cpp")
+    add_deps("TiltedReverse")
+    add_packages("tiltedcore", "mimalloc", "hopscotch-map", "minhook", "mem", "xbyak")
+
 target("TiltedReverse_Tests")
     set_kind("binary")
     set_group("Tests")
     add_files("Code/tests/src/*.cpp")
-    add_deps("TiltedReverse")
+    add_deps("TiltedReverse", "DLL")
     add_packages("tiltedcore", "catch2", "hopscotch-map", "minhook", "xbyak")
